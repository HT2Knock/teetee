{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "jsxSingleQuote": true,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "ignorePatterns": [
    "bun.lock",
    "dist/**",
    "coverage/**",
    "**/generated/**",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "docs/opencode-v2-events/*.jsonl",
  ],
  "trailingComma": "all",
  "sortImports": {
    "groups": ["builtin", "external", "internal", "parent", "sibling", "index", "side_effect", "unknown"],
    "newlinesBetween": true,
    "partitionByNewline": false,
  },
}
