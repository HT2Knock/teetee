{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/curly": ["error", "multi-line"],
    "eslint/max-depth": ["error", 4],
    "eslint/max-params": ["error", 4],
    "eslint/no-console": "error",
    "eslint/no-else-return": "error",
    "eslint/no-empty": "error",
    "eslint/no-empty-function": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-shadow": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-useless-call": "error",
    "eslint/no-useless-escape": "error",
    "eslint/no-useless-rename": "error",
    "eslint/no-var": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-object-spread": "error",
    "eslint/prefer-rest-params": "error",
    "eslint/prefer-template": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "promise/param-names": "error",
    "typescript/await-thenable": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/unbound-method": "error",
    "unicorn/no-invalid-fetch-options": "error",
    "unicorn/no-thenable": "off",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error"
  },
  "overrides": [
    {
      "files": ["kimaki/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "discord.js",
                "message": "Import Discord types and clients from src/adapters/discord instead."
              },
              {
                "name": "@opencode-ai/sdk",
                "message": "Use @opencode/client (OpenCode V2). @opencode-ai/sdk is OpenCode V1."
              },
              {
                "name": "node:child_process",
                "importNames": ["execSync", "spawnSync"],
                "message": "Use async execFile or spawn with a timeout."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["kimaki/src/adapters/discord/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["kimaki/src/plugin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "discord.js",
                "message": "Plugin code runs inside OpenCode: no Discord client."
              },
              {
                "name": "@opencode-ai/sdk",
                "message": "Use @opencode/client (OpenCode V2). @opencode-ai/sdk is OpenCode V1."
              },
              {
                "name": "node:child_process",
                "importNames": ["execSync", "spawnSync"],
                "message": "Use async execFile or spawn with a timeout."
              }
            ],
            "patterns": [
              {
                "group": ["**/db.ts", "**/db-client.ts", "**/logger.ts", "**/schema.ts", "**/schema-sql.ts"],
                "message": "Plugin code runs inside OpenCode: it must not import the logger or the database."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["kimaki/scripts/**", "docs/**"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      // The twin answers like a fetch handler: `throw new Response` returns an
      // HTTP response, so a Response is the error object there.
      "files": ["discord-digital-twin/src/server.ts"],
      "rules": {
        "typescript/only-throw-error": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/test/**", "**/tests/**"],
      "rules": {
        "eslint/max-params": "off",
        "eslint/no-shadow": "off",
        "eslint/no-useless-escape": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/unbound-method": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", "tmp", "coverage", "opensrc", "**/generated/**"]
}
